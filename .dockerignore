.git
.gitignore
.venv
**/__pycache__
*.pyc

# dados baixados/gerados pelos scripts de rede_cria_tabelas (podem chegar a dezenas de GB)
rede_cria_tabelas/dados-publicos
rede_cria_tabelas/dados-publicos-zip

# bases sqlite e rede.ini.local: sempre montados como volume em tempo de execução
# (deploy/docker-compose.yaml), não precisam ir para dentro da imagem -- e no caso do
# rede.ini.local, evita empacotar por engano valores de um ambiente dentro da imagem
rede/bases
rede/rede.ini.local

# certificados HTTPS: usados só pelo container nginx (imagem oficial, não passa por build),
# não precisam ir no contexto de build da imagem da aplicação
deploy/nginx/certs
