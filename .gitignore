*.pyc
.venv

# certificados HTTPS (auto-assinados ou reais): gerados/colocados localmente, nunca versionados
deploy/nginx/certs/*
!deploy/nginx/certs/.gitkeep

# atualiza_base.py: zips baixados da Receita e staging de extração/geração dos .db
# (arquivos de instrução .txt continuam versionados)
rede_cria_tabelas/dados-publicos-zip/*
!rede_cria_tabelas/dados-publicos-zip/*.txt
rede_cria_tabelas/dados-publicos/*
!rede_cria_tabelas/dados-publicos/*.txt
rede_cria_tabelas/logs/

# rede.ini.local: valores de config específicos do ambiente (email, referencia_bd,
# [RFB], etc.), sobrepostos ao rede.ini padrão em tempo de execução -- nunca
# versionado, ver deploy/README.md
rede/rede.ini.local
